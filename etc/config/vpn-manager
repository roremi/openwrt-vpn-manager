config global 'global'
    option enabled '1'
    option auto_rollback '1'
    option rollback_timeout '45'
    option health_interval '20'
    option strict_validation '1'
    option multiebay_api_base 'https://multiebay.com'
    option multiebay_api_key ''
    option multiebay_allow_http_proxy '1'

config profile 'vpn_a'
    option enabled '0'
    option name 'VPN A'
    option iface 'wg_vpn_a'
    option private_key ''
    option public_key ''
    option endpoint_host ''
    option endpoint_port '51820'
    list allowed_ips '0.0.0.0/0'
    list allowed_ips '::/0'
    option persistent_keepalive '25'
    option metric '100'
    option table_id '101'
    option fwmark '0x101'
    option kill_switch '0'

config zone_group 'guest'
    option zone 'guest'
    option client_isolation '1'
    option allow_interzone '0'
